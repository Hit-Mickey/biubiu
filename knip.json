{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**", "shared/**"],
  "ignore": ["dist/**", "src-tauri/**"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreDependencies": ["@tailwindcss/postcss"],
  "ignoreFiles": ["dist/**", "public/**", "src-tauri/**"],
  "include": ["files", "dependencies", "exports"],
  "includeEntryExports": true,
  "tags": ["-lintignore"]
}
